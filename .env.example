# Copie este arquivo e preencha o endereço público da recompensa:
#   cp .env.example .env
#
# Use SÓ o endereço público (bc1…, 1… ou 3…).
# Nunca cole a seed (frase de recuperação) nem a chave privada.

MINERADOR_ENDERECO=bc1qseuenderecoaqui

# Opcional — o Compose já usa estes padrões com Ollama local (custo zero de API).
# MINERADOR_IA_PROVEDOR=compat
# MINERADOR_IA_MODELO=llama3.2:1b
# MINERADOR_IA_BASE_URL=http://ollama:11434/v1
# MINERADOR_IA_CHAVE=ollama
